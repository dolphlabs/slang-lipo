# Copy to `.env` and fill in. Loaded automatically by config.load().
# Real process environment overrides these values.

LIPO_DB_PATH=lipo.db
LIPO_HTTP_ADDR=0.0.0.0
LIPO_HTTP_PORT=8080
LIPO_UPLOAD_DIR=data/uploads
LIPO_AUTH_PEPPER=change-me-to-a-long-random-secret

# Mail mode:
#   LIPO_MAIL_DEV=1  → never call Resend; log verification codes locally
#   LIPO_MAIL_DEV=0  → use Resend when RESEND_API_KEY is set
LIPO_MAIL_DEV=0

RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Lipo <onboarding@resend.dev>
